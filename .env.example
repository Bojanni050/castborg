# Eigenaar van het schema; gebruikt ALLEEN voor migraties (omzeilt RLS niet per se, maar is eigenaar van de tabellen)
DATABASE_URL_MIGRATOR=postgres://postgres:postgres@127.0.0.1:5432/ailead

# Rol die de API-runtime gebruikt: GEEN superuser, GEEN BYPASSRLS. Aangemaakt door migratie 0001.
DATABASE_URL_APP=postgres://ailead_app:change-me-in-production@127.0.0.1:5432/ailead

# API
# Minimaal 32 willekeurige tekens, bijv.: openssl rand -hex 32
SESSION_SECRET=
# Tijdelijk tot dashboard-auth (fase 1)
ADMIN_TOKEN=
PORT=8787

# AI-provider: "mistral" (standaard) of "stub" (lokaal, geen externe aanroepen)
PROVIDER=mistral
MISTRAL_API_KEY=
# Optioneel: standaard https://api.mistral.ai (EU)
# MISTRAL_BASE_URL=
# Maximaal aantal outputtokens per antwoord (standaard 800)
# MAX_OUTPUT_TOKENS=800
# Verplicht bij mistral. Haal de actuele prijzen uit je Mistral-account en reken om naar euro per miljoen tokens.
PRICE_INPUT_EUR_PER_M_TOKENS=
PRICE_OUTPUT_EUR_PER_M_TOKENS=
