# Eigenaar van het schema; gebruikt ALLEEN voor migraties.
DATABASE_URL_MIGRATOR=postgres://postgres:postgres@127.0.0.1:5435/ailead

# Wachtwoord voor de runtime-rol ailead_app. `pnpm db:migrate` zet dit op de rol (fail-closed:
# zonder deze variabele start de migratie niet). Minimaal 16 tekens, bijv.: openssl rand -hex 24
APP_DB_PASSWORD=

# Rol die de API-runtime gebruikt: GEEN superuser, GEEN BYPASSRLS. Het wachtwoord hier moet
# gelijk zijn aan APP_DB_PASSWORD.
DATABASE_URL_APP=postgres://ailead_app:VERANDER_DIT@127.0.0.1:5435/ailead

# API
# Minimaal 32 willekeurige tekens, bijv.: openssl rand -hex 32
SESSION_SECRET=
# Tijdelijk tot dashboard-auth (fase 1). Eén token:
ADMIN_TOKEN=
# Naam die bij ADMIN_TOKEN in de instellingenhistorie komt te staan (standaard "admin").
# ADMIN_TOKEN_NAME=bojan
# Of meerdere named tokens: "naam:token,naam2:token2". Gaat vóór ADMIN_TOKEN.
# ADMIN_TOKENS=bojan:tok1,anna:tok2
PORT=8787

# Dashboard: één operator-wachtwoord, geen gebruikersbeheer. Minimaal 12 tekens.
# Zonder deze variabele start de API wel, maar weigert /dashboard/login (503 not_configured).
# DASHBOARD_PASSWORD=
# Naam die in de instellingenhistorie als actor komt te staan bij een wijziging via het dashboard.
# DASHBOARD_ACTOR=bojan
# Zet op "true" zodra het dashboard achter https staat. De cookie is HttpOnly en SameSite=Lax;
# Secure kan alleen aan als er https voor zit, anders logt de browser zichzelf niet in.
# COOKIE_SECURE=false

# AI-provider: "mistral" (standaard) of "stub" (lokaal, geen externe aanroepen)
PROVIDER=mistral
# Alleen bij PROVIDER=stub: wachttijd per gestreamd woord in ms, zodat je het streamen ziet.
# STUB_STREAM_DELAY_MS=60
MISTRAL_API_KEY=
# Tijdelijk: als dit gevuld is, gebruikt elke site dit model in plaats van site_settings.model,
# en weigert de admin-route een model te zetten (409 model_locked). Bedoeld om snel te wisselen
# zolang de UI nog geen modellen laat kiezen. Let op: de prijzen hieronder zijn één paar voor álle
# sites, dus een duurder model met dezelfde prijs betekent dat het dagbudget te ruim staat.
# Vul de exacte model-id in, niet een "-latest"-alias: de prijs hoort bij de concrete versie.
# MISTRAL_MODEL=mistral-small-latest
# Optioneel: standaard https://api.mistral.ai (EU)
# MISTRAL_BASE_URL=
# Maximaal aantal outputtokens per antwoord. Dezelfde waarde wordt gebruikt voor de provider
# én voor de budgetreservering, dus niet alleen een provider-instelling.
# MAX_OUTPUT_TOKENS=800

# Verplicht bij mistral: zonder prijzen is het dagbudget betekenisloos.
# Let op: Mistral publiceert geen prijzen via de API (het Admin-API-endpoint /v1/admin/usage is
# Enterprise-only). Neem de prijzen over van https://docs.mistral.ai/inference/pricing (EUR-toggle)
# en noteer hieronder datum en modelversie.
# Gecontroleerd op 30-10-2026, omgerekend naar euro per miljoen tokens:
#   Mistral Small 4   input 0.15 USD / output 0.60 USD per Mtok
#   Mistral Medium 3.5 input 1.50 USD / output 7.50 USD per Mtok
# Pin het model op de concrete versie (bijv. mistral-small-4-0-26-03) in plaats van een
# "-latest"-alias: de prijs hoort bij het model, en een alias kan onder je budgetcontrole
# vandaan verschuiven.
PRICE_INPUT_EUR_PER_M_TOKENS=
PRICE_OUTPUT_EUR_PER_M_TOKENS=

# Waar een binnengekomen lead naartoe gaat: één POST met JSON. Werkt met n8n, Zapier, Make,
# een Slack-incoming-webhook of je eigen endpoint. Zonder deze variabele wordt een lead alleen
# opgeslagen, en dan leest niemand hem — de server waarschuwt daar bij het starten over.
# Bij een time-out of weigering blijft de lead gewoon opgeslagen; de bezoeker merkt niets.
# LEAD_WEBHOOK_URL=https://hooks.example.nl/lead
# Optioneel: de body wordt ondertekend met HMAC-SHA256 in de header x-ai-lead-signature
# (formaat sha256=<hex>), zodat de ontvanger kan controleren dat het bericht van deze API komt.
# LEAD_WEBHOOK_SECRET=

# Bewaartermijnen staan per site in de database (standaard 90 dagen voor gesprekken en 365 voor
# leads; 0 betekent nooit automatisch opruimen). Ze staan bewust niet hier: een klant hoort zijn
# eigen termijn te kunnen zien en wijzigen, niet de beheerder in een .env.
# Het opruimen zelf draait als script, niet als timer in de API:
#   pnpm retention
# Zet dat in cron of een systemd-timer, bijvoorbeeld dagelijks om 03:15:
#   15 3 * * * cd /srv/castborg && corepack pnpm retention >> /var/log/castborg-retention.log 2>&1
# Het script loopt alle sites langs en laat per site achter hoeveel er is verwijderd; in het
# dashboard staat hetzelfde in de sectie "Verwijderd".
